#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled host port tls tls_port tls_cert tls_key epg tv_plus legacy_extras fastway tunnel tunnel_token debug drm disable_auth key value
	config_load jiotv
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get host main host '0.0.0.0'
	config_get port main port '5001'
	config_get_bool tls main tls 1
	config_get tls_port main tls_port '5443'
	config_get tls_cert main tls_cert ''
	config_get tls_key main tls_key ''
	config_get_bool tunnel main tunnel 0
	config_get tunnel_token main tunnel_token ''
	uci_bool() {
		local result
		config_get_bool result main "$1" "$2"
		[ "$result" -eq 1 ] && echo true || echo false
	}
	epg=$(uci_bool epg 0)
	tv_plus=$(uci_bool tv_plus 0)
	# Earlier packages used the option name `extras`; still honour it so an
	# existing configuration is not switched off by an upgrade.
	config_get legacy_extras main extras ''
	if [ -n "$legacy_extras" ] && [ "$(uci_bool extras 0)" = true ]; then
		tv_plus=true
	fi
	fastway=$(uci_bool fastway 0)
	debug=$(uci_bool debug 0)
	drm=$(uci_bool drm 1)
	disable_auth=$(uci_bool disable_auth 0)

	procd_open_instance
	procd_set_param command /usr/bin/jiotv --skip-update-check serve --host "$host" --port "$port"
	if [ "$tls" -eq 1 ]; then
		procd_append_param command --tls --tls-port "$tls_port"
		# Pass each option through on its own: a lone cert or key must reach the
		# binary, which rejects an incomplete pair instead of silently falling
		# back to a self-signed certificate.
		[ -n "$tls_cert" ] && procd_append_param command --tls-cert "$tls_cert"
		[ -n "$tls_key" ] && procd_append_param command --tls-key "$tls_key"
	fi
	# The tunnel token is passed as an environment variable rather than an
	# argument so it does not appear in the process list.
	if [ "$tunnel" -eq 1 ]; then
		procd_append_param command --tunnel
	fi
	procd_set_param env JIOTV_PATH_PREFIX=/etc/jiotv
	procd_set_param env "JIOTV_EPG=$epg" "JIOTV_TVPLUS=$tv_plus" "JIOTV_EXTRAS=$tv_plus" "JIOTV_FASTWAY=$fastway" "JIOTV_DEBUG=$debug" "JIOTV_DRM=$drm" "JIOTV_DISABLE_AUTH=$disable_auth"
	[ -z "$tunnel_token" ] || procd_set_param env "JIOTV_TUNNEL_TOKEN=$tunnel_token"
	for key in title proxy custom_channels_file default_categories default_languages; do
		config_get value main "$key"
		[ -n "$value" ] && procd_set_param env "JIOTV_$(echo "$key" | tr '[:lower:]' '[:upper:]')=$value"
	done
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
