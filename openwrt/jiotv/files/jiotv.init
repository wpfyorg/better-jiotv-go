#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled host port epg extras debug drm disable_auth key value
	config_load jiotv
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get host main host '0.0.0.0'
	config_get port main port '5001'
	uci_bool() {
		local result
		config_get_bool result main "$1" "$2"
		[ "$result" -eq 1 ] && echo true || echo false
	}
	epg=$(uci_bool epg 0)
	extras=$(uci_bool extras 0)
	debug=$(uci_bool debug 0)
	drm=$(uci_bool drm 1)
	disable_auth=$(uci_bool disable_auth 0)

	procd_open_instance
	procd_set_param command /usr/bin/jiotv --skip-update-check serve --host "$host" --port "$port"
	procd_set_param env JIOTV_PATH_PREFIX=/etc/jiotv
	procd_set_param env "JIOTV_EPG=$epg" "JIOTV_EXTRAS=$extras" "JIOTV_DEBUG=$debug" "JIOTV_DRM=$drm" "JIOTV_DISABLE_AUTH=$disable_auth"
	for key in title proxy custom_channels_file default_categories default_languages; do
		config_get value main "$key"
		[ -n "$value" ] && procd_set_param env "JIOTV_$(echo "$key" | tr '[:lower:]' '[:upper:]')=$value"
	done
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
